{
  "name": "project-purify",
  "version": "0.8.0-dev",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.js"
  },
  "bin": {
    "project-purify": "./src/cli.js"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test",
    "serve": "python3 -m http.server 4173",
    "scan": "node ./src/cli.js",
    "update:confusables": "node ./scripts/update-confusables.mjs",
    "update:scripts": "node ./scripts/update-scripts.mjs",
    "update:unicode-data": "npm run update:confusables && npm run update:scripts",
    "build:extension": "node ./scripts/build-extension.mjs"
  },
  "description": "Detect suspicious Unicode text artifacts, explain them, and produce reproducible forensic evidence.",
  "keywords": [
    "unicode",
    "security",
    "confusables",
    "zero-width",
    "mixed-script",
    "text-forensics",
    "sarif",
    "reproducible"
  ],
  "license": "MIT"
}
